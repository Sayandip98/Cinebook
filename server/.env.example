NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cinebook?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
LOG_LEVEL=debug
BCRYPT_SALT_ROUNDS=12
# SEED_ADMIN_EMAIL=admin@cinebook.com
# SEED_ADMIN_PASSWORD=ChangeMe@123
JWT_ACCESS_SECRET=replace-with-48-random-bytes-in-hex
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
EMAIL_VERIFY_EXPIRES_HOURS=24
RESET_PASSWORD_EXPIRES_MINUTES=15
COOKIE_SAME_SITE=lax
# Leave SMTP unset in development: links are printed in the server console.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=CineBook <no-reply@cinebook.com>
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=